{
  "name": "myexample5306cardlist",
  "title": "CardList with drilldown",
  "type": "CardList",
  "bc": "myexample5306",
  "fields": [
    {
      "title": "Document",
      "key": "document",
      "type": "fileUpload",
      "fileIdKey": "documentId",
      "preview": {
        "enabled": true,
        "mode": "inline"
      },
      "drillDown": true
    },
    {
      "title": "Custom Field",
      "key": "customField",
      "type": "input"
    },
    {
      "title": "Custom Field Description",
      "key": "customFieldDescription",
      "type": "input"
    }
  ],
  "options": {
    "card": {
      "valueFieldKey": "document",
      "titleFieldKey": "customField",
      "descriptionFieldKey": "customFieldDescription"
    },
    "create": {
      "widget": "myexample5306form",
      "style": "popup"
    },
    "edit": {
      "widget": "myexample5306form",
      "style": "popup"
    },
    "actionGroups": {
      "include": [
        "create",
        "delete"
      ]
    }
  }
}
